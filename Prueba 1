            print("\nNo se pudo conectar")
            return None
    ip = red.ifconfig()[0]
    print("\nConectado IP: " + ip)
    return ip


#Servidor
def crear_servidor():
    srv = socket.socket()
    srv.bind(("", 80))
    srv.listen(5)
    srv.setblocking(False)
    return srv
 
def responder(cliente, cuerpo, estado="200 OK"):
    r = (
        "HTTP/1.1 " + estado + "\r\n"
        "Content-Type: application/json\r\n"
        "Content-Length: " + str(len(cuerpo)) + "\r\n"
        "\r\n" + cuerpo
    )
    cliente.send(r.encode())
    cliente.close()
 
def manejar_peticion(cliente):
    global mantenimiento
    datos = ""
    try:
        while "\r\n" not in datos:
            chunk = cliente.recv(1024).decode()
            if not chunk:
                break
            datos += chunk
    except:
        pass
    if not datos:
        cliente.close()
        return
    partes = datos.split("\r\n")[0].split(" ")
    if len(partes) < 2:
        cliente.close()
        return
    ruta = partes[1]
    print("Peticion: " + ruta)
 
    if ruta == "/estado":
        cuerpo = ujson.dumps({"cantidades": cantidades, "ventas": ventas})
        responder(cliente, cuerpo)
 
    elif ruta == "/mantenimiento_on":
        mantenimiento = True
        modo_mantenimiento(True)
        responder(cliente, ujson.dumps({"mantenimiento": True}))
 
    elif ruta == "/mantenimiento_off":
        mantenimiento = False
        modo_mantenimiento(False)
        responder(cliente, ujson.dumps({"mantenimiento": False}))
 
    else:
        responder(cliente, ujson.dumps({"error": "ruta no encontrada"}), "404 Not Found")
 
