#Seleccionar producto
def leer_producto():
    valor = pot.read_u16()
    if valor < 21845:
        return 1
    elif valor < 43690:
        return 2
    else:
        return 3

#Cantidades
def cargar_cantidades():
    try:
        with open("cantidades.txt", "r") as f:
            datos = ujson.loads(f.read())
            return datos
    except:
        return {1: 9, 2: 9, 3: 9} #Si no hay archivo, cargar cantidades completasd

def guardar_cantidades():
    with open("cantidades.txt", "w") as f:
        f.write(ujson.dumps(cantidades))

cantidades = cargar_cantidades()

#Ventas
ventas = {1: 0, 2: 0, 3: 0}
 
#Mantenimiento
mantenimiento = False


#Inicio
cerrar_compuerta()
led_amarillo.value(0)
producto_actual = leer_producto()
mostrar(cantidades[producto_actual])
actualizar_leds()
conectar_wifi()
servidor = crear_servidor()


#Loop
while True:
    producto = leer_producto()
    if producto != producto_actual:
        producto_actual = producto
        mostrar(cantidades[producto_actual])
        actualizar_leds()
        print(f"Producto: {producto_actual}, Cantidad: {cantidades[producto_actual]}")
    if boton.value() == 0:
        esperar_soltar_boton()
        if cantidades[producto_actual] > 0 and not mantenimiento:   #Hay stock
            cantidades[producto_actual] -= 1
            ventas[producto_actual] += 1
            guardar_cantidades()
            mostrar(cantidades[producto_actual])
            actualizar_leds()
            print(f"Vendido! Producto: {producto_actual}, Quedan: {cantidades[producto_actual]}")
            abrir_compuerta()
            time.sleep(2)
            cerrar_compuerta()
        else:
            #No hay stock o mantenimiento activo
            print(f"Producto {producto_actual} sin unidades :(")
        time.sleep(0.4)  #antirrebote
    #Atender peticiones HTTP
    try:
        cliente, _ = servidor.accept()
        manejar_peticion(cliente)
    except:
        pass
    time.sleep(0.1)
