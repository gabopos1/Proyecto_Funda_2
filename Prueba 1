def conectar_wifi():
    red = network.WLAN(network.STA_IF)
    red.active(True)
    red.connect(SSID, PASSWORD)
    print("Conectando al WiFi", end="")
    intentos = 0
    while not red.isconnected():
        print(".", end="")
        time.sleep(0.5)
        intentos += 1
