        seg.value(val)

# Servo
servo = PWM(Pin(15))
servo.freq(50)

def mover_servo(angulo):
    duty = int((angulo / 180 * 7500) + 2500)
    servo.duty_u16(duty)

def abrir_compuerta():
    mover_servo(90)

def cerrar_compuerta():
    mover_servo(0)

